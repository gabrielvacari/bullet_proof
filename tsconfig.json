{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* strict is non-negotiable: shared/ is imported by two runtimes. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    /*
     * Module resolution goes through package.json "imports" (#shared/*, #client/*,
     * #server/*), NOT tsconfig "paths". See specs/000-m0-walking-box/research.md R2:
     * "paths" is a type-check-only convenience -- tsc does not rewrite specifiers and
     * this project runs --noEmit, so an aliased import resolves for the Vite-bundled
     * client and throws in the plain Node server. Subpath imports resolve natively in
     * both. Specifiers therefore carry an explicit .ts extension, which Node's type
     * stripping requires.
     */
    "allowImportingTsExtensions": true
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "client/**/*.ts",
    "*.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
